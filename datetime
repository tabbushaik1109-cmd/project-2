<!DOCTYPE html>
<html>
<head>
  <title>Show Date & Time</title>
  <script>
    function showDateTime() {
      document.getElementById("output").innerHTML = new Date();
    }
  </script>
</head>
<body>
  <h2>Current Date and Time</h2>
  <button onclick="showDateTime()">Show Now</button>
  <p id="output"></p>
</body>
</html>
